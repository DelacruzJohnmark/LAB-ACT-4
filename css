* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Arial, Helvetica, sans-serif;
  background: #f4f7fb;
  color: #1f2937;
}

.container {
  width: min(1120px, 92%);
  margin: 0 auto;
  padding: 42px 0 60px;
}

.hero {
  background: #ffffff;
  border-radius: 18px;
  padding: 34px 38px;
  margin-bottom: 22px;
  border: 1px solid #e5e7eb;
  box-shadow: 0 8px 28px rgba(15, 23, 42, 0.06);
}

.eyebrow {
  margin: 0 0 7px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: #2563eb;
}

h1, h2, p {
  margin-top: 0;
}

h1 {
  margin-bottom: 8px;
  font-size: clamp(28px, 4vw, 42px);
}

.subtitle {
  margin-bottom: 0;
  color: #64748b;
}

.controls {
  display: grid;
  grid-template-columns: 1fr 220px auto;
  gap: 16px;
  align-items: end;
  background: #ffffff;
  padding: 22px;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  box-shadow: 0 8px 28px rgba(15, 23, 42, 0.05);
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

label {
  font-size: 13px;
  font-weight: 700;
  color: #475569;
}

input, select {
  width: 100%;
  height: 44px;
  padding: 0 13px;
  border: 1px solid #cbd5e1;
  border-radius: 9px;
  background: #fff;
  font-size: 15px;
  outline: none;
}

input:focus, select:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
}

.button-group {
  display: flex;
  gap: 9px;
}

button {
  height: 44px;
  padding: 0 18px;
  border: 0;
  border-radius: 9px;
  background: #2563eb;
  color: #fff;
  font-weight: 700;
  cursor: pointer;
}

button:hover {
  filter: brightness(0.95);
}

button.secondary {
  background: #e2e8f0;
  color: #334155;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin: 22px 0;
}

.summary-card {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  padding: 22px;
  box-shadow: 0 8px 28px rgba(15, 23, 42, 0.05);
}

.summary-card span {
  display: block;
  margin-bottom: 10px;
  color: #64748b;
  font-size: 14px;
}

.summary-card strong {
  font-size: 28px;
}

.products-section {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 8px 28px rgba(15, 23, 42, 0.05);
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
}

.section-heading h2 {
  margin-bottom: 0;
}

#resultCount {
  color: #64748b;
  font-size: 14px;
}

.product-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.product-card {
  border: 1px solid #e2e8f0;
  border-radius: 13px;
  padding: 18px;
  background: #fbfdff;
}

.product-card h3 {
  margin: 0 0 8px;
  font-size: 18px;
}

.category {
  display: inline-block;
  margin-bottom: 15px;
  padding: 5px 9px;
  border-radius: 999px;
  background: #e0e7ff;
  color: #3730a3;
  font-size: 12px;
  font-weight: 700;
}

.product-details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin: 0;
}

.product-details div {
  padding: 10px;
  background: #f1f5f9;
  border-radius: 9px;
}

.product-details dt {
  color: #64748b;
  font-size: 12px;
  margin-bottom: 4px;
}

.product-details dd {
  margin: 0;
  font-weight: 700;
}

.status {
  margin-top: 14px;
  font-weight: 700;
  font-size: 13px;
}

.status.in-stock { color: #15803d; }
.status.low-stock { color: #b45309; }
.status.out-of-stock { color: #dc2626; }

.no-results {
  margin: 0;
  padding: 35px 10px;
  text-align: center;
  color: #64748b;
  font-weight: 700;
}

@media (max-width: 850px) {
  .controls {
    grid-template-columns: 1fr 1fr;
  }

  .search-field {
    grid-column: 1 / -1;
  }

  .button-group {
    grid-column: 1 / -1;
  }

  .product-list {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 580px) {
  .summary-grid,
  .product-list,
  .controls {
    grid-template-columns: 1fr;
  }

  .search-field {
    grid-column: auto;
  }

  .button-group {
    grid-column: auto;
  }

  .button-group button {
    flex: 1;
  }

  .container {
    width: 94%;
    padding-top: 20px;
  }
}
